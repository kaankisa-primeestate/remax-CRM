# PostgreSQL bağlantı bilgileri
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=remax_crm

# API portu
PORT=3000

# Geliştirme ortamında tabloları otomatik oluştur (production'da false yapın!)
DB_SYNCHRONIZE=true

# JWT token'ları imzalamak için kullanılan gizli anahtar.
# ÖNEMLİ: Canlıya alırken bunu uzun, rastgele bir metinle değiştirin!
JWT_SECRET=lutfen-bunu-uzun-ve-rastgele-bir-metinle-degistirin

# İlk kurulumda otomatik oluşturulacak Broker (Admin) hesabı bilgileri.
# Giriş yaptıktan sonra şifrenizi değiştirmeniz önerilir.
DEFAULT_BROKER_EMAIL=admin@remax.local
DEFAULT_BROKER_PASSWORD=broker123
